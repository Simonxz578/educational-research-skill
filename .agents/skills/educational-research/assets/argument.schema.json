          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "supports",
            "contradicts",
            "qualifies",
            "depends_on"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "kind",
        "rationale"
      ],
      "title": "Edge",
      "type": "object"
    }
