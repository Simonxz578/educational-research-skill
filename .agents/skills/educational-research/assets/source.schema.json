{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 100,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "rationale",
        "checked_at"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "default": "",
          "title": "Family",
          "type": "string"
        },
        "given": {
          "default": "",
          "title": "Given",
          "type": "string"
        },
        "literal": {
          "default": "",
          "title": "Literal",
          "type": "string"
        }
      },
      "title": "Author",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "source-author claim",
            "source evidence",
            "researcher interpretation"
          ],
