      },
      "title": "Gaps",
      "type": "array"
    },
    "definitions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Definitions",
      "type": "object"
    },
    "alignment": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Alignment",
      "type": "object"
    }
