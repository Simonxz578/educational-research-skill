        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "warrant": {
          "default": "not specified",
          "title": "Warrant",
          "type": "string"
        },
        "warrant_id": {
          "default": "",
          "title": "Warrant Id",
          "type": "string"
        },
        "objection": {
          "default": "Rival interpretation requires review",
          "title": "Objection",
          "type": "string"
        },
        "objection_id": {
          "default": "",
          "title": "Objection Id",
          "type": "string"
        },
        "qualification": {
          "default": "Provisional; evaluate evidence access and inference limits",
          "title": "Qualification",
          "type": "string"
        },
        "confidence": {
          "default": "provisional",
          "title": "Confidence",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
