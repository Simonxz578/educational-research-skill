{
  "$defs": {
    "AbstractEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "publication_id": {
          "title": "Publication Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "provider": {
          "enum": [
            "publisher",
            "Crossref",
            "ERIC",
            "user_attested"
          ],
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "const": "publishedAbstract",
          "default": "publishedAbstract",
          "title": "Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "extraction_sha256": {
          "title": "Extraction Sha256",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "identity_verified": {
          "title": "Identity Verified",
          "type": "boolean"
        },
        "rights": {
          "$ref": "#/$defs/EvidenceRights"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "explanation_checked": {
          "default": false,
          "title": "Explanation Checked",
          "type": "boolean"
        },
        "interpretation": {
          "default": "Full-text evidence, detailed methods and inferential limits have not been checked.",
          "title": "Interpretation",
          "type": "string"
        },
        "quotation": {
          "default": "",
          "title": "Quotation",
          "type": "string"
        },
        "quotation_locator": {
          "default": "Published abstract",
          "title": "Quotation Locator",
          "type": "string"
        },
        "reader": {
          "default": "native published-abstract verifier; not a full-text reader",
          "title": "Reader",
          "type": "string"
        },
        "scope": {
          "const": "ABSTRACT_ONLY",
          "default": "ABSTRACT_ONLY",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "publication_id",
        "title",
        "source_url",
        "provider",
        "text",
        "artifact_path",
        "artifact_sha256",
        "extraction_sha256",
        "checked_at",
        "identity_verified",
        "rights"
      ],
      "title": "AbstractEvidence",
      "type": "object"
    },
    "AccessAttempt": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "title": "Route",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "status": {
          "enum": [
            "OA_FULL_TEXT_VERIFIED",
            "REPOSITORY_FULL_TEXT_VERIFIED",
            "USER_SUPPLIED_LAWFUL_TEXT",
            "ABSTRACT_ONLY",
            "PAYWALL_OR_LOGIN_BLOCKED",
            "FULL_TEXT_RETRIEVED_NOT_VALIDATED",
            "FULL_TEXT_UNAVAILABLE",
            "RIGHTS_OR_VERSION_UNCLEAR"
          ],
          "title": "Status",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": [
        "route",
        "url",
        "checked_at",
        "status",
        "reason"
      ],
      "title": "AccessAttempt",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 100,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "rationale",
        "checked_at"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "default": "",
          "title": "Family",
          "type": "string"
        },
        "given": {
          "default": "",
          "title": "Given",
          "type": "string"
        },
        "literal": {
          "default": "",
          "title": "Literal",
          "type": "string"
        }
      },
      "title": "Author",
      "type": "object"
    },
    "DocumentProvenance": {
      "additionalProperties": false,
      "properties": {
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "processing_permission": {
          "default": "not_checked",
          "enum": [
            "allowed",
            "local_only",
            "not_checked",
            "forbidden"
          ],
          "title": "Processing Permission",
          "type": "string"
        },
        "permission_evidence": {
          "default": "",
          "title": "Permission Evidence",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "legal_basis": {
          "title": "Legal Basis",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "acquired_at": {
          "title": "Acquired At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "local_path",
        "sha256",
        "version",
        "legal_basis",
        "licence",
        "acquired_at"
      ],
      "title": "DocumentProvenance",
      "type": "object"
    },
    "EvidenceRights": {
      "additionalProperties": false,
      "properties": {
        "public_word_allowance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Word Allowance"
        },
        "access": {
          "default": "not_checked",
          "enum": [
            "allowed",
            "denied",
            "not_checked"
          ],
          "title": "Access",
          "type": "string"
        },
        "processing": {
          "default": "not_checked",
          "enum": [
            "allowed",
            "denied",
            "not_checked"
          ],
          "title": "Processing",
          "type": "string"
        },
        "private_retention": {
          "default": "not_checked",
          "enum": [
            "allowed",
            "denied",
            "not_checked"
          ],
          "title": "Private Retention",
          "type": "string"
        },
        "public_quotation": {
          "default": "not_checked",
          "enum": [
            "allowed",
            "denied",
            "not_checked"
          ],
          "title": "Public Quotation",
          "type": "string"
        },
        "access_basis": {
          "default": "",
          "title": "Access Basis",
          "type": "string"
        },
        "processing_basis": {
          "default": "",
          "title": "Processing Basis",
          "type": "string"
        },
        "retention_basis": {
          "default": "",
          "title": "Retention Basis",
          "type": "string"
        },
        "quotation_basis": {
          "default": "",
          "title": "Quotation Basis",
          "type": "string"
        },
        "licence_url": {
          "default": "",
          "title": "Licence Url",
          "type": "string"
        }
      },
      "title": "EvidenceRights",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "source-author claim",
            "source evidence",
            "researcher interpretation"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_ids",
        "basis"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "FullTextAcquisition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "4.2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "default": "FULL_TEXT_UNAVAILABLE",
          "enum": [
            "OA_FULL_TEXT_VERIFIED",
            "REPOSITORY_FULL_TEXT_VERIFIED",
            "USER_SUPPLIED_LAWFUL_TEXT",
            "ABSTRACT_ONLY",
            "PAYWALL_OR_LOGIN_BLOCKED",
            "FULL_TEXT_RETRIEVED_NOT_VALIDATED",
            "FULL_TEXT_UNAVAILABLE",
            "RIGHTS_OR_VERSION_UNCLEAR"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FullTextLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "extracted_text_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extracted Text Path"
        },
        "extracted_text_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extracted Text Sha256"
        },
        "media_type": {
          "default": "",
          "title": "Media Type",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "structure": {
          "items": {
            "type": "string"
          },
          "title": "Structure",
          "type": "array"
        },
        "paragraphs": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/AccessAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "metadata_identity": {
          "default": "UNVERIFIED",
          "title": "Metadata Identity",
          "type": "string"
        },
        "retrieval_complete": {
          "default": false,
          "title": "Retrieval Complete",
          "type": "boolean"
        },
        "content_validated": {
          "default": false,
          "title": "Content Validated",
          "type": "boolean"
        },
        "legal_usage_verified": {
          "default": false,
          "title": "Legal Usage Verified",
          "type": "boolean"
        },
        "close_reading_completed": {
          "default": false,
          "title": "Close Reading Completed",
          "type": "boolean"
        },
        "version_difference": {
          "default": "",
          "title": "Version Difference",
          "type": "string"
        },
        "notice": {
          "default": "Machine checks do not establish comprehension, interpretive accuracy or public-reproduction rights.",
          "title": "Notice",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "checked_at"
      ],
      "title": "FullTextAcquisition",
      "type": "object"
    },
    "FullTextLocation": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "route": {
          "enum": [
            "publisher",
            "eric",
            "repository",
            "core",
            "manual",
            "user"
          ],
          "title": "Route",
          "type": "string"
        },
        "version": {
          "default": "unknown",
          "enum": [
            "publishedVersion",
            "acceptedVersion",
            "submittedVersion",
            "unknown"
          ],
          "title": "Version",
          "type": "string"
        },
        "licence_url": {
          "default": "",
          "title": "Licence Url",
          "type": "string"
        },
        "licence_evidence_url": {
          "default": "",
          "title": "Licence Evidence Url",
          "type": "string"
        },
        "legal_basis": {
          "default": "",
          "title": "Legal Basis",
          "type": "string"
        },
        "processing_permission": {
          "default": "unclear",
          "enum": [
            "allowed",
            "local_only",
            "unclear",
            "forbidden"
          ],
          "title": "Processing Permission",
          "type": "string"
        },
        "permission_evidence": {
          "default": "",
          "title": "Permission Evidence",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "terms_checked": {
          "default": false,
          "title": "Terms Checked",
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "route"
      ],
      "title": "FullTextLocation",
      "type": "object"
    },
    "FullTextReading": {
      "additionalProperties": false,
      "properties": {
        "quote_policy": {
          "default": "not_checked",
          "enum": [
            "short_excerpts_permitted",
            "no_reproduction",
            "not_checked"
          ],
          "title": "Quote Policy",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "FULL_TEXT_READ_BY_AGENT",
            "USER_SUPPLIED_FULL_TEXT",
            "ABSTRACT_ONLY",
            "METADATA_ONLY",
            "UNVERIFIED"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/DocumentProvenance"
        },
        "read_at": {
          "title": "Read At",
          "type": "string"
        },
        "reader": {
          "title": "Reader",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "whole_work",
            "relevant_chapter",
            "substantive_sections",
            "fragment"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "scope_description": {
          "title": "Scope Description",
          "type": "string"
        },
        "scholarly_kind": {
          "enum": [
            "empirical",
            "theoretical",
            "review",
            "policy"
          ],
          "title": "Scholarly Kind",
          "type": "string"
        },
        "central_thesis": {
          "title": "Central Thesis",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "population": {
          "title": "Population",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "setting": {
          "title": "Setting",
          "type": "string"
        },
        "design": {
          "title": "Design",
          "type": "string"
        },
        "constructs": {
          "items": {
            "type": "string"
          },
          "title": "Constructs",
          "type": "array"
        },
        "analytic_approach": {
          "title": "Analytic Approach",
          "type": "string"
        },
        "findings": {
          "title": "Findings",
          "type": "string"
        },
        "limitations": {
          "title": "Limitations",
          "type": "string"
        },
        "relevance_to_rq": {
          "title": "Relevance To Rq",
          "type": "string"
        },
        "relevance_rationale": {
          "title": "Relevance Rationale",
          "type": "string"
        },
        "highly_relevant": {
          "title": "Highly Relevant",
          "type": "boolean"
        },
        "inference_limits": {
          "title": "Inference Limits",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ReadingEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "not_applicable": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Not Applicable",
          "type": "object"
        },
        "overlaps": {
          "items": {
            "type": "string"
          },
          "title": "Overlaps",
          "type": "array"
        },
        "opposing_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Opposing Source Ids",
          "type": "array"
        },
        "own_implication": {
          "title": "Own Implication",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "access_status",
        "document",
        "read_at",
        "reader",
        "coverage",
        "scope_description",
        "scholarly_kind",
        "central_thesis",
        "question",
        "population",
        "stage",
        "setting",
        "design",
        "constructs",
        "analytic_approach",
        "findings",
        "limitations",
        "relevance_to_rq",
        "relevance_rationale",
        "highly_relevant",
        "inference_limits",
        "evidence",
        "own_implication"
      ],
      "title": "FullTextReading",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "JIF",
            "SJR",
            "CiteScore",
            "h5-index",
            "article_citations",
            "FWCI"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "quartile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quartile"
        }
      },
      "required": [
        "name",
        "value",
        "source",
        "checked_at"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation"
        },
        "translation_kind": {
          "default": "not translated",
          "enum": [
            "user",
            "published",
            "not translated"
          ],
          "title": "Translation Kind",
          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_id"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ReadingEvidence": {
      "additionalProperties": false,
      "properties": {
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "content_type": {
          "enum": [
            "claim",
            "method",
            "result",
            "limitation",
            "counterpoint",
            "definition",
            "mechanism",
            "reasoning",
            "boundary"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "paraphrase": {
          "title": "Paraphrase",
          "type": "string"
        },
        "exact_span": {
          "default": "",
          "title": "Exact Span",
          "type": "string"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        },
        "author_warrant": {
          "default": "",
          "title": "Author Warrant",
          "type": "string"
        },
        "researcher_inference": {
          "default": "",
          "title": "Researcher Inference",
          "type": "string"
        },
        "qualification": {
          "default": "",
          "title": "Qualification",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "status": {
          "default": "not_checked",
          "enum": [
            "checked_against_text",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
