          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_ids",
        "basis"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "JIF",
            "SJR",
            "CiteScore",
            "h5-index",
            "article_citations",
            "FWCI"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "quartile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quartile"
        }
      },
      "required": [
        "name",
        "value",
        "source",
        "checked_at"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
