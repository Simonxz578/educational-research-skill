          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_id"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "locator": {
          "default": "location unknown",
          "title": "Locator",
          "type": "string"
        },
