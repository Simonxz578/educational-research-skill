{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 100,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "rationale",
        "checked_at"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "default": "",
          "title": "Family",
          "type": "string"
        },
        "given": {
          "default": "",
          "title": "Given",
          "type": "string"
        },
        "literal": {
          "default": "",
          "title": "Literal",
          "type": "string"
        }
      },
      "title": "Author",
      "type": "object"
    },
    "DocumentProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "legal_basis": {
          "title": "Legal Basis",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "acquired_at": {
          "title": "Acquired At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "local_path",
        "sha256",
        "version",
        "legal_basis",
        "licence",
        "acquired_at"
      ],
      "title": "DocumentProvenance",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "source-author claim",
            "source evidence",
            "researcher interpretation"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_ids",
        "basis"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "FullTextReading": {
      "additionalProperties": false,
      "properties": {
        "quote_policy": {
          "default": "not_checked",
          "enum": [
            "short_excerpts_permitted",
            "no_reproduction",
            "not_checked"
          ],
          "title": "Quote Policy",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "FULL_TEXT_READ_BY_AGENT",
            "USER_SUPPLIED_FULL_TEXT",
            "ABSTRACT_ONLY",
            "METADATA_ONLY",
            "UNVERIFIED"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/DocumentProvenance"
        },
        "read_at": {
          "title": "Read At",
          "type": "string"
        },
        "reader": {
          "title": "Reader",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "whole_work",
            "relevant_chapter",
            "substantive_sections",
            "fragment"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "scope_description": {
          "title": "Scope Description",
          "type": "string"
        },
        "scholarly_kind": {
          "enum": [
            "empirical",
            "theoretical",
            "review",
            "policy"
          ],
          "title": "Scholarly Kind",
          "type": "string"
        },
        "central_thesis": {
          "title": "Central Thesis",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "population": {
          "title": "Population",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "setting": {
          "title": "Setting",
          "type": "string"
        },
        "design": {
          "title": "Design",
          "type": "string"
        },
        "constructs": {
          "items": {
            "type": "string"
          },
          "title": "Constructs",
          "type": "array"
        },
        "analytic_approach": {
          "title": "Analytic Approach",
          "type": "string"
        },
        "findings": {
          "title": "Findings",
          "type": "string"
        },
        "limitations": {
          "title": "Limitations",
          "type": "string"
        },
        "relevance_to_rq": {
          "title": "Relevance To Rq",
          "type": "string"
        },
        "relevance_rationale": {
          "title": "Relevance Rationale",
          "type": "string"
        },
        "highly_relevant": {
          "title": "Highly Relevant",
          "type": "boolean"
        },
        "inference_limits": {
          "title": "Inference Limits",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ReadingEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "not_applicable": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Not Applicable",
          "type": "object"
        },
        "overlaps": {
          "items": {
            "type": "string"
          },
          "title": "Overlaps",
          "type": "array"
        },
        "opposing_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Opposing Source Ids",
          "type": "array"
        },
        "own_implication": {
          "title": "Own Implication",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "access_status",
        "document",
        "read_at",
        "reader",
        "coverage",
        "scope_description",
        "scholarly_kind",
        "central_thesis",
        "question",
        "population",
        "stage",
        "setting",
        "design",
        "constructs",
        "analytic_approach",
        "findings",
        "limitations",
        "relevance_to_rq",
        "relevance_rationale",
        "highly_relevant",
        "inference_limits",
        "evidence",
        "own_implication"
      ],
      "title": "FullTextReading",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "JIF",
            "SJR",
            "CiteScore",
            "h5-index",
            "article_citations",
            "FWCI"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "quartile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quartile"
        }
      },
      "required": [
        "name",
        "value",
        "source",
        "checked_at"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation"
        },
        "translation_kind": {
          "default": "not translated",
          "enum": [
            "user",
            "published",
            "not translated"
          ],
          "title": "Translation Kind",
          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_id"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ReadingEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "content_type": {
          "enum": [
            "claim",
            "method",
            "result",
            "limitation",
            "counterpoint",
            "definition",
            "mechanism",
            "reasoning",
            "boundary"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "paraphrase": {
          "title": "Paraphrase",
          "type": "string"
        },
        "exact_span": {
          "default": "",
          "title": "Exact Span",
          "type": "string"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        },
        "author_warrant": {
          "default": "",
          "title": "Author Warrant",
          "type": "string"
        },
        "researcher_inference": {
          "default": "",
          "title": "Researcher Inference",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "status": {
          "default": "not_checked",
          "enum": [
            "checked_against_text",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "finding_kind": {
          "enum": [
            "observed",
            "tested",
            "reported",
            "interpretation",
            "potential",
            "not_applicable"
          ],
          "title": "Finding Kind",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "content_type",
        "paraphrase",
        "locator",
        "finding_kind"
      ],
      "title": "ReadingEvidence",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "locator": {
          "default": "location unknown",
          "title": "Locator",
          "type": "string"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        },
        "printed_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "licence": {
          "default": "not verified",
          "title": "Licence",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "url"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "3.0",
      "enum": [
        "1.0",
        "2.0",
        "3.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "reading": {
      "anyOf": [
        {
          "$ref": "#/$defs/FullTextReading"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Id"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "authors": {
      "items": {
        "$ref": "#/$defs/Author"
      },
      "title": "Authors",
      "type": "array"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    },
    "online_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Online Year"
    },
    "issue_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue Year"
    },
    "type": {
      "default": "article-journal",
      "title": "Type",
      "type": "string"
    },
    "journal": {
      "default": "",
      "title": "Journal",
      "type": "string"
    },
    "publisher": {
      "default": "",
      "title": "Publisher",
      "type": "string"
    },
    "volume": {
      "default": "",
      "title": "Volume",
      "type": "string"
    },
    "issue": {
      "default": "",
      "title": "Issue",
      "type": "string"
    },
    "pages": {
      "default": "",
      "title": "Pages",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "url": {
      "default": "",
      "title": "Url",
      "type": "string"
    },
    "eric_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eric Id"
    },
    "peer_reviewed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peer Reviewed"
    },
    "descriptors": {
      "items": {
        "type": "string"
      },
      "title": "Descriptors",
      "type": "array"
    },
    "education_level": {
      "default": "not reported",
      "title": "Education Level",
      "type": "string"
    },
    "country": {
      "default": "not reported",
      "title": "Country",
      "type": "string"
    },
    "participants": {
      "default": "not reported",
      "title": "Participants",
      "type": "string"
    },
    "design": {
      "default": "not reported",
      "title": "Design",
      "type": "string"
    },
    "evidence_kind": {
      "default": "not verified",
      "title": "Evidence Kind",
      "type": "string"
    },
    "objective": {
      "default": "not verified",
      "title": "Objective",
      "type": "string"
    },
    "theory": {
      "default": "not verified",
      "title": "Theory",
      "type": "string"
    },
    "abstract": {
      "default": "",
      "title": "Abstract",
      "type": "string"
    },
    "summary": {
      "default": "not verified",
      "title": "Summary",
      "type": "string"
    },
    "source_argument": {
      "default": "not verified",
      "title": "Source Argument",
      "type": "string"
    },
    "target_argument": {
      "default": "not constructed",
      "title": "Target Argument",
      "type": "string"
    },
    "relevance_explanation": {
      "default": "not assessed",
      "title": "Relevance Explanation",
      "type": "string"
    },
    "limitations": {
      "default": "not verified",
      "title": "Limitations",
      "type": "string"
    },
    "evidence_strength": {
      "default": "not assessed",
      "title": "Evidence Strength",
      "type": "string"
    },
    "cluster": {
      "default": "Unclassified",
      "title": "Cluster",
      "type": "string"
    },
    "role": {
      "default": "candidate",
      "title": "Role",
      "type": "string"
    },
    "comparison_ids": {
      "items": {
        "type": "string"
      },
      "title": "Comparison Ids",
      "type": "array"
    },
    "relationship": {
      "default": "not assessed",
      "title": "Relationship",
      "type": "string"
    },
    "access": {
      "default": "METADATA_ONLY",
      "enum": [
        "FULL_TEXT_VERIFIED",
        "ABSTRACT_ONLY",
        "METADATA_ONLY",
        "USER_SUPPLIED",
        "UNAVAILABLE",
        "FULL_TEXT_READ_BY_AGENT",
        "USER_SUPPLIED_FULL_TEXT",
        "UNVERIFIED"
      ],
      "title": "Access",
      "type": "string"
    },
    "identity": {
      "default": "UNVERIFIED",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "CONFLICT",
        "SYNTHETIC"
      ],
      "title": "Identity",
      "type": "string"
    },
    "publication_status": {
      "default": "not checked",
      "title": "Publication Status",
      "type": "string"
    },
    "checked_at": {
      "title": "Checked At",
      "type": "string"
    },
    "providers": {
      "items": {
        "type": "string"
      },
      "title": "Providers",
      "type": "array"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "quotes": {
      "items": {
        "$ref": "#/$defs/Quote"
      },
      "title": "Quotes",
      "type": "array"
    },
    "extractions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extraction"
      },
      "title": "Extractions",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "assessments": {
      "additionalProperties": {
        "$ref": "#/$defs/Assessment"
      },
      "title": "Assessments",
      "type": "object"
    },
    "provenance": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Provenance",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "quote_budget": {
      "default": 20,
      "maximum": 200,
      "minimum": 0,
      "title": "Quote Budget",
      "type": "integer"
    },
    "permissive_licence_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permissive Licence Url"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Source",
  "type": "object"
}
